    <ui:VisualElement name="VisualElement" enabled="true" style="flex-grow: 1; opacity: 1; -unity-background-scale-mode: scale-and-crop; align-self: auto; background-color: rgb(0, 0, 0); align-items: center; justify-content: center; flex-direction: column; align-content: auto;">
        <ui:Label text="_Game Name_" name="ResumeText" style="width: 438px; height: 111px; background-color: rgba(56, 56, 56, 0); border-left-color: rgb(95, 95, 95); border-right-color: rgb(95, 95, 95); border-top-color: rgb(95, 95, 95); border-bottom-color: rgb(95, 95, 95); color: rgb(255, 255, 255); -unity-text-align: middle-center; white-space: nowrap; font-size: 70%; -unity-text-auto-size: none; justify-content: flex-start; align-self: center; -unity-text-outline-color: rgba(56, 56, 56, 0); -unity-background-image-tint-color: rgb(35, 35, 35); -unity-text-generator: standard; margin-bottom: 7%;"/>
