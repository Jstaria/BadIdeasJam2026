:root {
}

.currentStyle {
    right: 10%;
    width: 40%;
    height: 10%;
    align-content: flex-start;
    align-self: flex-end;
    align-items: stretch;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    font-size: 35%;
    color: rgb(0, 0, 0);
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}

.currentStyle:hover {
    right: 10%;
    width: 40%;
    height: 10%;
    align-content: flex-start;
    align-self: flex-end;
    align-items: stretch;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    scale: 1.1 1.1;
}

.currentStyle:active {
    right: 10%;
    width: 40%;
    height: 10%;
    align-content: flex-start;
    align-self: flex-end;
    align-items: stretch;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: rgb(109, 109, 109);
}
